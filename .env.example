# 한국관광공사 TourAPI 인증키
# https://api.visitkorea.or.kr 에서 발급
VITE_TOUR_API_KEY=your_tour_api_key_here

# 카카오 JavaScript 앱키
# https://developers.kakao.com 에서 발급
VITE_KAKAO_MAP_KEY=your_kakao_js_app_key_here

# 카카오 REST API 키 (지도탭 장소 검색 - 전화번호/카카오맵 링크 연동용)
# https://developers.kakao.com 에서 발급 (JS 키와 다른 키)
# 영업시간/영업중 여부는 이 API로 제공되지 않아 미연동 (카카오맵 자체 페이지에서만 확인 가능)
VITE_KAKAO_REST_KEY=your_kakao_rest_api_key_here

# Claude API (AI 코스 추천용 - 서버사이드에서만 사용할 것)
# VITE_ 접두사 쓰지 말 것 - 클라이언트에 노출됨
# ANTHROPIC_API_KEY=your_anthropic_key_here
