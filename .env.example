# ──────────────────────────────────────────────
# 서버 전용 환경변수 (Vercel 대시보드에 설정)
# VITE_ 접두사 없음 → 브라우저에 노출되지 않음
# ──────────────────────────────────────────────

# 한국관광공사 TourAPI 인증키
# https://api.visitkorea.or.kr 에서 발급
TOUR_API_KEY=your_tour_api_key_here

# 카카오 REST API 키 (지도탭 장소 검색 - 전화번호/카카오맵 링크 연동용)
# https://developers.kakao.com 에서 발급
KAKAO_REST_KEY=your_kakao_rest_api_key_here

# 기상청 단기예보 API 키 (홈화면 날씨 연동)
# https://www.data.go.kr 에서 "기상청_단기예보" 검색 후 발급
WEATHER_API_KEY=your_weather_api_key_here

# ──────────────────────────────────────────────
# 클라이언트 환경변수 (VITE_ 접두사 → 브라우저에 노출됨)
# 공개 키만 여기에 넣을 것
# ──────────────────────────────────────────────

# 카카오 JavaScript 앱키 (카카오맵 SDK 로드용 - 공개 키)
# https://developers.kakao.com 에서 발급
VITE_KAKAO_MAP_KEY=your_kakao_js_app_key_here

# Claude API (AI 코스 추천용 - 서버사이드에서만 사용할 것)
# VITE_ 접두사 쓰지 말 것 - 클라이언트에 노출됨
# ANTHROPIC_API_KEY=your_anthropic_key_here
